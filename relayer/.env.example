# EVM source chain RPC endpoint (required)
PERIHELION_EVM_RPC_URL=http://localhost:8545

# Stellar RPC / Horizon endpoint (required)
PERIHELION_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# EVM escrow contract that emits bridge messages (required, 0x-prefixed 20-byte address)
PERIHELION_ESCROW_ADDRESS=

# Soroban settlement (LayerZero OApp) contract id (required, C…, 56 chars)
PERIHELION_SETTLEMENT_CONTRACT=

# EVM chain endpoint ID (required, positive integer)
PERIHELION_SOURCE_EID=30101

# Stellar chain endpoint ID (required, positive integer)
PERIHELION_STELLAR_EID=40161

# Stellar network passphrase (required)
STELLAR_NETWORK=Test SDF Network ; September 2015

# Stellar signing secret key for submitting transactions (required, S…, 56 chars)
SIGNER_SECRET=

# Block confirmations to wait before relaying a source message
PERIHELION_CONFIRMATIONS=6

# Poll interval for new messages, milliseconds
PERIHELION_POLL_INTERVAL_MS=5000

# Path to the cursor checkpoint file, persisted after every tick so a restart
# resumes from here instead of re-scanning from genesis or skipping messages
# emitted while the relayer was down.
PERIHELION_CHECKPOINT_FILE=./.perihelion-relayer-checkpoint.json

# HTTP port for health/readiness/metrics endpoint
PERIHELION_HEALTH_PORT=8080
